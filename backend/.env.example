# ======================================================================
# APLIKASI
# ======================================================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL="http://localhost:3000"
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ======================================================================
# LOGGING
# ======================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ======================================================================
# DATABASE
# ======================================================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=harmoni_clothing
DB_USERNAME=harmoni
DB_PASSWORD=

# ======================================================================
# SESSION, CORS & SANCTUM (login berbasis cookie)
# ======================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi: SESSION_SECURE_COOKIE otomatis true bila APP_ENV=production.
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# Domain frontend yang memakai sesi cookie (tanpa skema, pisahkan dengan koma).
SANCTUM_STATEFUL_DOMAINS=localhost:3000
# Asal frontend yang boleh memanggil API (pisahkan dengan koma). Wajib memuat domain produksi.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ======================================================================
# CACHE, QUEUE & REDIS
# ======================================================================
CACHE_STORE=redis
# CACHE_PREFIX=
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ======================================================================
# REALTIME (chat & notifikasi)
# ======================================================================
BROADCAST_CONNECTION=reverb
# Laravel Reverb (realtime chat & notifikasi, FR-028/029) — self-hosted,
# use this when BROADCAST_CONNECTION=reverb (local dev, or a VPS).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Hosted Pusher Channels — use this when BROADCAST_CONNECTION=pusher, i.e.
# whenever the backend host can't run Reverb as a second always-on process
# (see DEPLOYMENT.md). Free "Sandbox" plan values from your Pusher app's
# dashboard (App Keys tab). Frontend needs the matching NEXT_PUBLIC_PUSHER_*
# pair, not these (secret must never reach the browser).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# ======================================================================
# EMAIL (Resend)
# ======================================================================
# Resend (HTTP API). Locally use MAIL_MAILER=log to avoid sending real mail.
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@harmoniclothing.com"
MAIL_FROM_NAME="${APP_NAME}"
# Resend API key (dashboard > API Keys). The sending domain must be verified
# in Resend and MAIL_FROM_ADDRESS must be on that domain.
RESEND_API_KEY=

# ======================================================================
# PENYIMPANAN FILE (lokal / Cloudflare R2)
# ======================================================================
# 'local' untuk dev. Untuk R2 isi FILESYSTEM_DISK_PUBLIC/PRIVATE di bawah.
FILESYSTEM_DISK=local
# Cloudflare R2 (S3-compatible). Leave FILESYSTEM_DISK_PUBLIC/PRIVATE unset
# locally (defaults to the local disks) — set them to r2_public/r2_private
# in production once the AWS_* R2 credentials below are filled in.
# FILESYSTEM_DISK_PUBLIC=r2_public
# FILESYSTEM_DISK_PRIVATE=r2_private
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET_PUBLIC=
AWS_BUCKET_PRIVATE=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ======================================================================
# PEMBAYARAN (Midtrans)
# ======================================================================
# Midtrans (payment gateway)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ======================================================================
# PENGIRIMAN (Biteship)
# ======================================================================
# Biteship (shipping & auto tracking resi)
BITESHIP_API_KEY=
# Shared secret embedded as ?token=... on the webhook URL registered in
# Biteship's dashboard — Biteship has no documented request-signing scheme, so
# this is what verifies a callback actually came from Biteship.
BITESHIP_WEBHOOK_TOKEN=
# Single fixed production/warehouse origin — used on every rate-check and booking call.
BITESHIP_ORIGIN_NAME="Harmoni Clothing"
BITESHIP_ORIGIN_PHONE=
BITESHIP_ORIGIN_ADDRESS=
BITESHIP_ORIGIN_POSTAL_CODE=
# v1 simplification: flat weight per item (grams) — no per-variant weight field yet.
BITESHIP_ITEM_WEIGHT_GRAMS=250
BITESHIP_COURIERS=jne,jnt,sicepat

# ======================================================================
# ATURAN BISNIS (nilai default ada di config/business.php)
# ======================================================================
# Placeholder — belum ada keputusan bisnis. Lihat config/business.php.
# CREATOR_COMMISSION_RATE=0.20
# CREATOR_PAYOUT_MINIMUM=50000

# ======================================================================
# PENCAIRAN KOMISI CREATOR
# ======================================================================
# Kosong = pencairan belum aktif (komisi tetap 'terhutang'). Isi saat provider disbursement siap.
DISBURSEMENT_API_KEY=
