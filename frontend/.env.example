NEXT_PUBLIC_API_URL=http://localhost:8000
# Self-hosted Reverb (local dev, or a VPS later) — leave the Pusher pair below
# blank when using these.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
# Hosted Pusher Channels — set these (App Keys tab) when the backend can't run
# Reverb as a second always-on process; lib/echo.ts picks Pusher automatically
# whenever NEXT_PUBLIC_PUSHER_APP_KEY is non-empty, Reverb otherwise.
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
