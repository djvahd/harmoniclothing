# Build-time values for the Cloudflare (OpenNext) deploy. NEXT_PUBLIC_* are
# inlined into the browser bundle, so only public values belong here.

# The site's own origin: the browser calls /api/*, /sanctum/*, etc. on the same
# host, and next.config.mjs rewrites them to BACKEND_ORIGIN (first-party cookies).
NEXT_PUBLIC_API_URL=https://harmoniclothing.com
BACKEND_ORIGIN=https://api.harmoniclothing.com

# Realtime: hosted Pusher Channels (fill in from the Pusher dashboard) or leave
# blank to fall back to Reverb. See lib/echo.ts.
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTER=

# Midtrans Snap client key (public by design). Sandbox key until Production.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
